{
  "name": "auflinie",
  "private": true,
  "description": "Tooling für die Jekyll-Site (Stylelint, ESLint) — die Site selbst braucht kein Node.",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.8.0"
  },
  "scripts": {
    "lint:css": "stylelint \"assets/_sass/**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"assets/_sass/**/*.scss\"",
    "lint:js": "eslint \"assets/js/**/*.js\" \"tests/**/*.js\" playwright.config.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:a11y:baseline": "UPDATE_A11Y=1 playwright test tests/visual/a11y.spec.js"
  }
}
