# Lokale Entwicklung: Vorlage für .env (kopieren nach .env, .env ist gitignored).
#
# GitHub-Token für jekyll-gist / jekyll-github-metadata, um beim lokalen Build
# das API-Rate-Limit zu erhöhen. Optional – ohne Token baut die Site ebenfalls,
# nur mit niedrigerem GitHub-API-Limit.
#
# In der CI wird GH_TOKEN direkt als Env gesetzt (siehe .github/workflows), dort
# ist keine .env nötig.
JEKYLL_GITHUB_TOKEN=${GH_TOKEN}
